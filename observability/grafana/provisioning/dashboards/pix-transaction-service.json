{
  "title": "Pix Simulator - Transaction Service",
  "uid": "pix-transaction-service",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Taxa de Requisições /transfer (req/s)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{uri=\"/api/v1/pix/transfer\"}[1m]))",
          "legendFormat": "requisições/s",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Latência p50 / p95 / p99 (ms)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(http_server_requests_seconds_bucket{uri=\"/api/v1/pix/transfer\"}[5m])) by (le)) * 1000",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket{uri=\"/api/v1/pix/transfer\"}[5m])) by (le)) * 1000",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(http_server_requests_seconds_bucket{uri=\"/api/v1/pix/transfer\"}[5m])) by (le)) * 1000",
          "legendFormat": "p99",
          "refId": "C"
        }
      ]
    },
    {
      "id": 3,
      "title": "Taxa de Sucesso vs Erro (%)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{uri=\"/api/v1/pix/transfer\", status=~\"2..\"}[1m])) / sum(rate(http_server_requests_seconds_count{uri=\"/api/v1/pix/transfer\"}[1m])) * 100",
          "legendFormat": "% sucesso (2xx)",
          "refId": "A"
        },
        {
          "expr": "sum(rate(http_server_requests_seconds_count{uri=\"/api/v1/pix/transfer\", status!~\"2..\"}[1m])) / sum(rate(http_server_requests_seconds_count{uri=\"/api/v1/pix/transfer\"}[1m])) * 100",
          "legendFormat": "% erro (não-2xx)",
          "refId": "B"
        }
      ]
    },
    {
      "id": 4,
      "title": "Estado do Circuit Breaker (pixTransfer)",
      "type": "state-timeline",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "resilience4j_circuitbreaker_state{name=\"pixTransfer\"}",
          "legendFormat": "{{state}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Conexões Ativas no Pool (Hikari)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "hikaricp_connections_active{pool=\"HikariPool-1\"}",
          "legendFormat": "ativas",
          "refId": "A"
        },
        {
          "expr": "hikaricp_connections_idle{pool=\"HikariPool-1\"}",
          "legendFormat": "ociosas",
          "refId": "B"
        }
      ]
    },
    {
      "id": 6,
      "title": "Chamadas de Retry (pixTransfer)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "sum(rate(resilience4j_retry_calls_total{name=\"pixTransfer\"}[1m])) by (kind)",
          "legendFormat": "{{kind}}",
          "refId": "A"
        }
      ]
    }
  ]
}
